<UserControl x:Class="PharmaDesk.Views.CartView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel><TextBlock DockPanel.Dock="Top" Text="Cos de cumparaturi" FontSize="28" FontWeight="Bold" Margin="0,0,0,12" />
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produs" Binding="{Binding Medicine.Name}" Width="*" />
                        <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="80" />
                        <DataGridTextColumn Header="Pret" Binding="{Binding Medicine.UnitPrice}" Width="100" />
                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal}" Width="100" />
                        <DataGridTemplateColumn Header="Actiuni" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="-" Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><Button Content="+" Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><Button Content="Sterge" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Checkout" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Adresa livrare" /><TextBox Text="{Binding ShippingAddress, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" />
                <TextBlock Text="Metoda plata" /><ComboBox SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Content"><ComboBoxItem Content="Card" /><ComboBoxItem Content="Cash la livrare" /></ComboBox>
                <Button Content="Incarca prescriptie PDF" Command="{Binding PickPrescriptionCommand}" Style="{StaticResource GhostButton}" />
                <TextBlock Text="{Binding PrescriptionPath}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Total, StringFormat=Total produse: {0:0.00} RON}" FontSize="22" FontWeight="Bold" Margin="0,14" />
                <Button Content="Plateste simulat si plaseaza comanda" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
