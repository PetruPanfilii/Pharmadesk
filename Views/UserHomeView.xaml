<UserControl x:Class="PharmaDesk.Views.UserHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PharmaDesk.Views.Components">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,28,0,12" />
        </Style>
        <Style x:Key="FilterBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <!-- Hero Banner Section -->
                <Grid Height="380" Margin="0,0,0,20">
                    <Grid.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/Products/hero-premium.png" Stretch="UniformToFill" />
                    </Grid.Background>
                    
                    <!-- Gradient Overlay -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0F0F0F" Offset="0" />
                                <GradientStop Color="#CC0F0F0F" Offset="0.4" />
                                <GradientStop Color="#550F0F0F" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    
                    <!-- Hero Content -->
                    <StackPanel VerticalAlignment="Center" Margin="40,0,500,0">
                        <TextBlock Text="FARMACIA PREMIUM" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{Binding HeroProduct.Name, FallbackValue='Bine ai venit'}" 
                                  Foreground="{StaticResource TextBrush}" 
                                  FontSize="44" 
                                  FontWeight="Black" 
                                  TextWrapping="Wrap" 
                                  MaxWidth="400" />
                        <TextBlock Text="{Binding HeroProduct.Description, FallbackValue='Descoperă selecția noastră premium de medicamente și suplimente.'}" 
                                  Foreground="{StaticResource MutedTextBrush}" 
                                  FontSize="16" 
                                  TextWrapping="Wrap" 
                                  Margin="0,12,0,18"
                                  MaxWidth="400" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕ Adauga in cos" 
                                   Command="{Binding AddToCartCommand}" 
                                   CommandParameter="{Binding HeroProduct}" 
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,0,8,0" />
                            <Button Content="🛒 Vezi cosul" 
                                   Command="{Binding DataContext.GoCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                   Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Cart Badge -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,32,0" 
                           Background="{StaticResource AccentBrush}" 
                           CornerRadius="8" 
                           Padding="16,12"
                           Effect="{StaticResource HighShadow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cos:" Foreground="{StaticResource TextBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding CartCount}" 
                                      Foreground="{StaticResource TextBrush}" 
                                      FontSize="20" 
                                      FontWeight="Black"
                                      Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search & Filter Bar -->
                <Border Style="{StaticResource FilterBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                Padding="14,10" />
                        <ComboBox Grid.Column="1" 
                                 ItemsSource="{Binding Categories}" 
                                 DisplayMemberPath="Name" 
                                 SelectedItem="{Binding SelectedCategory}"
                                 Foreground="{StaticResource TextBrush}"
                                 Background="{StaticResource DarkBgBrush}"
                                 Padding="10,8" 
                                 Margin="10,0,0,0" />
                        <Button Grid.Column="2" 
                               Content="Cauta" 
                               Command="{Binding SearchCommand}" 
                               Style="{StaticResource PrimaryButton}"
                               Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <!-- Main Products Grid (4 columns) -->
                <StackPanel Margin="0">
                    <TextBlock Text="Toate produsele" Style="{StaticResource SectionTitle}" />
                    
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="280" Margin="0">
                                    <components:ProductCard DataContext="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Sections (Featured, Top Rated, etc) -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                
                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="280" Margin="0">
                                                <components:ProductCard DataContext="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer Spacing -->
                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
