<UserControl x:Class="PharmaDesk.Views.RegisterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
            <StackPanel>
                <TextBlock Text="Cont nou client" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Nume complet" /><TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Username" /><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Email" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Parola" /><TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" />
                <Button Content="Creeaza cont" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="Inapoi la login" Command="{Binding DataContext.GoLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
