<UserControl x:Class="PharmaDesk.Views.AdminOrdersView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OrderStatusBadge" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource DarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">
                <!-- Title -->
                <TextBlock Text="📨 Comenzi Primite" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,20" />
                
                <!-- Orders Data Grid -->
                <Border Background="{DynamicResource CardBgBrush}"
                       CornerRadius="8"
                       Padding="16"
                       BorderBrush="{DynamicResource BorderDarkBrush}"
                       BorderThickness="1"
                       Effect="{StaticResource SoftShadow}">
                    <DataGrid ItemsSource="{Binding Orders}" 
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             EnableRowVirtualization="True"
                             EnableColumnVirtualization="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             Background="{DynamicResource DarkBgBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderDarkBrush}"
                             RowHeight="50"
                             HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="📦 Numar Comanda" 
                                              Binding="{Binding OrderNumber}" 
                                              Width="140"
                                              Foreground="{DynamicResource AccentBrush}" />
                            
                            <DataGridTextColumn Header="👤 Client" 
                                              Binding="{Binding User.FullName}" 
                                              Width="200" />
                            
                            <DataGridTextColumn Header="📅 Data Comenzii" 
                                              Binding="{Binding OrderDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" 
                                              Width="150" />
                            
                            <DataGridTextColumn Header="💰 Total" 
                                              Binding="{Binding GrandTotal, StringFormat={}{0:F2} RON}" 
                                              Width="120"
                                              Foreground="{DynamicResource AccentBrush}" />
                            
                            <DataGridTemplateColumn Header="⚙️ Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" 
                                               Padding="8,4"
                                               HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Noua">
                                                            <Setter Property="Background" Value="#FFD97706" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Confirmata">
                                                            <Setter Property="Background" Value="#FF0EA5E9" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Trimisa">
                                                            <Setter Property="Background" Value="#FF10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completa">
                                                            <Setter Property="Background" Value="#FF10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Anulata">
                                                            <Setter Property="Background" Value="#FFF87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" 
                                                      Style="{StaticResource OrderStatusBadge}"
                                                      Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="🎯 Actiuni" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✓ Expediaza" 
                                                   Command="{Binding DataContext.ShipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                   CommandParameter="{Binding}" 
                                                   Style="{StaticResource PrimaryButton}"
                                                   Padding="8,4"
                                                   FontSize="11"
                                                   Margin="3,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Footer Spacing -->
                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
