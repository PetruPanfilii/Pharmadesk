<UserControl x:Class="PharmaDesk.Views.CategoryManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel><TextBlock DockPanel.Dock="Top" Text="Categorii" FontSize="28" FontWeight="Bold" />
                <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns><DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="220" /><DataGridTextColumn Header="Descriere" Binding="{Binding Description}" Width="*" /><DataGridTemplateColumn Header="Actiuni"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel><TextBlock Text="Editor categorie" FontSize="22" FontWeight="Bold" /><TextBlock Text="Nume" /><TextBox Text="{Binding Editor.Name}" /><TextBlock Text="Descriere" /><TextBox Text="{Binding Editor.Description}" AcceptsReturn="True" Height="100" /><Button Content="Salveaza" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel>
        </Border>
    </Grid>
</UserControl>
