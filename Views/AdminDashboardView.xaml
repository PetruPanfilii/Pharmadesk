<UserControl x:Class="PharmaDesk.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KPICard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource DarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dashboard Farmacie"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Monitorizare pentru admin si farmacist"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Actualizeaza"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="-8,0,-8,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="Clienti" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ClientsCount}" Foreground="{DynamicResource TextBrush}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock Text="conturi client" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="Farmacisti" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding PharmacistsCount}" Foreground="{DynamicResource AccentBrush}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock Text="conturi personal" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="Comenzi" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding OrdersCount}" Foreground="{DynamicResource TextBrush}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock Text="total in sistem" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="Produse" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ProductsCount}" Foreground="{DynamicResource TextBrush}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock Text="active in catalog" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Stoc scazut" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="17" />
                                <TextBlock Text="{Binding LowStockCount, StringFormat='({0})'}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="17" Margin="8,0,0,0" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding LowStock}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      MinHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produs" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Stoc" Binding="{Binding StockQuantity}" Width="70" />
                                    <DataGridTextColumn Header="Minim" Binding="{Binding ReorderLevel}" Width="70" />
                                    <DataGridTemplateColumn Header="Actiune" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Reaprovizioneaza"
                                                        Command="{Binding DataContext.RestockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="8,4"
                                                        FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="10,0,0,20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Comenzi recente"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="Bold"
                                       FontSize="17"
                                       Margin="0,0,0,12" />

                            <DataGrid ItemsSource="{Binding RecentOrders}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      MinHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Comanda" Binding="{Binding OrderNumber}" Width="130" />
                                    <DataGridTextColumn Header="Client" Binding="{Binding User.FullName}" Width="*" />
                                    <DataGridTextColumn Header="Data" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM HH:mm}}" Width="110" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:0.00} RON}" Width="110" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                    <DataGridTemplateColumn Header="Actiune" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Expediaza"
                                                        Command="{Binding DataContext.ShipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="8,4"
                                                        FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
