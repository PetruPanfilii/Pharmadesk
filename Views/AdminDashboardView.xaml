<UserControl x:Class="PharmaDesk.Views.AdminDashboardView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KPICard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource DarkBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="0">
                <!-- Page Title -->
                <TextBlock Text="📊 Dashboard Farmacie" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,0,0,24" />
                
                <!-- KPI Cards Row 1 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Clients Card -->
                    <Border Grid.Column="0" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="👥 Clienti" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ClientsCount}" 
                                      Foreground="{StaticResource TextBrush}" 
                                      FontSize="36" 
                                      FontWeight="Bold"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="Utilizatori activi" 
                                      Foreground="{StaticResource MutedTextBrush}" 
                                      FontSize="11"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Pharmacists Card -->
                    <Border Grid.Column="1" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="💊 Farmacisti" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding PharmacistsCount}" 
                                      Foreground="{StaticResource AccentBrush}" 
                                      FontSize="36" 
                                      FontWeight="Bold"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="Conturi active" 
                                      Foreground="{StaticResource MutedTextBrush}" 
                                      FontSize="11"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Orders Card -->
                    <Border Grid.Column="2" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="📦 Comenzi" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding OrdersCount}" 
                                      Foreground="{StaticResource TextBrush}" 
                                      FontSize="36" 
                                      FontWeight="Bold"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="Procesate luna aceasta" 
                                      Foreground="{StaticResource MutedTextBrush}" 
                                      FontSize="11"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Products Card -->
                    <Border Grid.Column="3" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <TextBlock Text="📋 Produse" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ProductsCount}" 
                                      Foreground="{StaticResource TextBrush}" 
                                      FontSize="36" 
                                      FontWeight="Bold"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="In catalog" 
                                      Foreground="{StaticResource MutedTextBrush}" 
                                      FontSize="11"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Low Stock Alert Card -->
                <Border Style="{StaticResource KPICard}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚠️ Stoc Scazut" 
                                      Foreground="{StaticResource AccentBrush}" 
                                      FontWeight="Bold" 
                                      FontSize="16" />
                            <TextBlock Text="{Binding LowStockCount, StringFormat='({0})'}" 
                                      Foreground="{StaticResource TextBrush}" 
                                      FontSize="16"
                                      FontWeight="Bold"
                                      Margin="8,0,0,0" />
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding LowStock}" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True"
                                 EnableRowVirtualization="True"
                                 EnableColumnVirtualization="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 Background="{StaticResource DarkBgBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderDarkBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produs" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Stoc Curent" Binding="{Binding StockQuantity}" Width="120" />
                                <DataGridTextColumn Header="Prag Minim" Binding="{Binding ReorderLevel}" Width="120" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Recent Orders Section -->
                <Border Style="{StaticResource KPICard}">
                    <StackPanel>
                        <TextBlock Text="📨 Comenzi Recente" 
                                  Foreground="{StaticResource TextBrush}" 
                                  FontWeight="Bold" 
                                  FontSize="16" 
                                  Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding Orders}" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True"
                                 Background="{StaticResource DarkBgBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderDarkBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Numar Comanda" Binding="{Binding OrderNumber}" Width="120" />
                                <DataGridTextColumn Header="Client" Binding="{Binding User.FullName}" Width="*" />
                                <DataGridTextColumn Header="Data" Binding="{Binding OrderDate, StringFormat={}{0:dd/MM/yyyy}}" Width="100" />
                                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='${0:F2}'}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Footer Spacing -->
                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
