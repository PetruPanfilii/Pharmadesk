<Window x:Class="PharmaDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PharmaDesk.ViewModels"
        xmlns:views="clr-namespace:PharmaDesk.Views"
        Title="PharmaDesk" Height="820" Width="1280" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource DarkBgBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}"><views:RegisterView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserHomeViewModel}"><views:UserHomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CartViewModel}"><views:CartView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderHistoryViewModel}"><views:OrderHistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><views:ProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}"><views:AdminDashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductManagementViewModel}"><views:ProductManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryManagementViewModel}"><views:CategoryManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}"><views:UserManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminOrdersViewModel}"><views:AdminOrdersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}"><views:AuditLogView /></DataTemplate>
        
        <!-- Storyboards for Sidebar Animation -->
        <Storyboard x:Key="CollapseSidebarStoryboard">
            <DoubleAnimation Storyboard.TargetName="SidebarColumn" 
                           Storyboard.TargetProperty="Width" 
                           From="260" To="50" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ExpandSidebarStoryboard">
            <DoubleAnimation Storyboard.TargetName="SidebarColumn" 
                           Storyboard.TargetProperty="Width" 
                           From="50" To="260" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar (Dark theme) -->
        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel LastChildFill="True">
                <!-- Header with Toggle Button -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,20" Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo Section (hidden when collapsed) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0" 
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Image Source="pack://application:,,,/Resources/logo.png" Width="40" Height="40" Stretch="Uniform" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PharmaDesk" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="farmacie" Foreground="{StaticResource MutedTextBrush}" FontSize="9" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Toggle Button -->
                    <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}" 
                           Style="{StaticResource GhostButton}" 
                           Padding="6" Margin="4" ToolTip="Toggle Sidebar"
                           Background="Transparent" BorderThickness="0">
                        <TextBlock Text="☰" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                    </Button>
                </Grid>

                <!-- Navigation Content -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- User Info -->
                        <TextBlock Text="{Binding CurrentUserName}" 
                                  Foreground="{StaticResource TextBrush}" 
                                  FontWeight="SemiBold" 
                                  Margin="8,0,0,12"
                                  TextTrimming="CharacterEllipsis"
                                  Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                        
                        <!-- User Menu -->
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="🏠 Acasa" Command="{Binding GoHomeCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="🛒 Cos" Command="{Binding GoCartCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="📦 Comenzi" Command="{Binding GoOrdersCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="👤 Cont" Command="{Binding GoProfileCommand}" Style="{StaticResource GhostButton}" />
                            
                            <!-- Pharmacy Admin Menu -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanManageMedicines}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <Border Margin="0,12,0,0" Height="1" Background="{StaticResource BorderDarkBrush}" 
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                
                                <TextBlock Text="FARMACIE" 
                                          Foreground="{StaticResource AccentBrush}" 
                                          FontWeight="Bold" 
                                          Margin="8,12,0,8"
                                          Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                
                                <Button Content="📊 Dashboard" Command="{Binding GoAdminDashboardCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="💊 Medicamente" Command="{Binding GoProductsCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="📂 Categorii" Command="{Binding GoCategoriesCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="📨 Comenzi" Command="{Binding GoAdminOrdersCommand}" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                            
                            <!-- Admin Menu -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <Border Margin="0,12,0,0" Height="1" Background="{StaticResource BorderDarkBrush}" 
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                
                                <TextBlock Text="ADMIN" 
                                          Foreground="{StaticResource AccentBrush}" 
                                          FontWeight="Bold" 
                                          Margin="8,12,0,8"
                                          Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                
                                <Button Content="👥 Utilizatori" Command="{Binding GoUsersCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="📈 Rapoarte" Command="{Binding GoReportsCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="📋 Audit" Command="{Binding GoAuditCommand}" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="🌓 Tema" Command="{Binding ToggleThemeCommand}" Style="{StaticResource GhostButton}" 
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="🚪 Logout" Command="{Binding LogoutCommand}" 
                           Style="{StaticResource PrimaryButton}" 
                           Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="{StaticResource DarkBgBrush}">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="22" />
            
            <!-- Toast Notification -->
            <Border Background="{StaticResource CardBgBrush}" 
                   CornerRadius="8" 
                   Padding="16" 
                   BorderBrush="{StaticResource AccentBrush}"
                   BorderThickness="1"
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom" 
                   Margin="24" 
                   Effect="{StaticResource HighShadow}"
                   Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ToastMessage}" 
                          Foreground="{StaticResource TextBrush}" 
                          FontWeight="SemiBold" />
            </Border>
        </Grid>
    </Grid>
</Window>
